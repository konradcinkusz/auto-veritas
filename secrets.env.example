# Copy to .env (gitignored) to override the local compose defaults.
# Tiers: [local-optional] has a working weak default; [ci] is set by the workflow;
# [deploy] exists only in the Fly.io secret store, set from CI — never here.

# [local-optional] Password for the local compose postgres (default: autoveritas-dev).
POSTGRES_PASSWORD=

# [local-optional] Seeded SuperAdmin — the account the owner's agent uses locally.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# [deploy] Set via `fly secrets set` from the deploy workflow, documented in
# flyio/SECRETS.md. Listed here so every variable has one named home:
#   ConnectionStrings__DefaultConnection   (per service, assembled in the pipeline)
#   Jwt__PrivateKeyPem                     (authservice only — the RS256 trust root)
#   InitialAdmin__Password                 (authservice only)

# The RS256 dev signing key is NOT an env var: scripts/generate-jwt-key.sh writes
# certs/jwt-signing.dev.pem (gitignored) and compose mounts it as a file.
