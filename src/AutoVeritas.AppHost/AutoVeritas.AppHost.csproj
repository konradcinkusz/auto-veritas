<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <RootNamespace>AutoVeritas.AppHost</RootNamespace>
    <UserSecretsId>autoveritas-apphost</UserSecretsId>
    <!-- ASPIREJAVASCRIPT001: the JavaScript hosting APIs ship as evaluation-only in Aspire 13.5; dev-topology only, so accepted. -->
    <NoWarn>$(NoWarn);ASPIREJAVASCRIPT001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoVeritas.OffersService\AutoVeritas.OffersService.csproj" />
  </ItemGroup>

</Project>
