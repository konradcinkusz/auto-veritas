<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AutoVeritas.OffersService</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;1587</NoWarn>
    <UserSecretsId>autoveritas-offersservice</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoVeritas.ServiceDefaults\AutoVeritas.ServiceDefaults.csproj" />
    <ProjectReference Include="..\AutoVeritas.OffersService.Data\AutoVeritas.OffersService.Data.csproj" />
    <!--
      Referenced so the migrations assembly lands in this project's output directory,
      where dotnet ef and Database:MigrationsAssembly resolve it. It never references back.
    -->
    <ProjectReference Include="..\AutoVeritas.OffersService.Migrations.PostgreSQL\AutoVeritas.OffersService.Migrations.PostgreSQL.csproj" />
  </ItemGroup>

</Project>
